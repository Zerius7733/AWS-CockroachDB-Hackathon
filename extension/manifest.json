{
  "manifest_version": 3,
  "name": "Northstar Job Capture",
  "version": "1.1.0",
  "description": "Capture job posting details from the current page and log them to Northstar.",
  "action": {
    "default_title": "Log job to Northstar",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
