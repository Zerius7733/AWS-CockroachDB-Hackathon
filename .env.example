# Copy the General connection string from CockroachDB Cloud's Connect dialog.
# Keep sslmode=verify-full in production.
DATABASE_URL=postgresql://username:password@host:26257/defaultdb?sslmode=verify-full

# Keep this small for serverless/container deployments and increase only after measuring.
DATABASE_POOL_SIZE=5

# Server-side OpenAI credentials for resume extraction and job matching.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Reuse identical memory-backed job searches until this threshold expires.
# Cache hits do not call OpenAI or consume model/web-search tokens.
JOB_SEARCH_CACHE_MINUTES=60

# Password sessions are stored in CockroachDB. Valid range: 1-30 days.
AUTH_SESSION_DAYS=7
