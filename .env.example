# Copy this file to .env and add your server-side credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# CockroachDB SQL connection used by the application.
DATABASE_URL=

# CockroachDB Cloud MCP credentials. Export these in the shell that launches
# Codex; Codex does not automatically read this app's .env file.
COCKROACH_CLUSTER_ID=
COCKROACH_MCP_API_KEY=
