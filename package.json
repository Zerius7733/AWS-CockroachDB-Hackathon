{
  "name": "northstar-application-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "concurrently \"node --watch --env-file-if-exists=.env server.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "db:migrate-csv": "node --env-file-if-exists=.env scripts/migrate-csv.js",
    "db:claim-demo": "node --env-file-if-exists=.env scripts/claim-demo-data.js",
    "db:verify-isolation": "node --env-file-if-exists=.env scripts/verify-user-isolation.js",
    "test": "node --test",
    "test:extension": "node extension/test-extractor.mjs",
    "start": "node --env-file-if-exists=.env server.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "d3-sankey": "^0.12.3",
    "express": "latest",
    "lucide-react": "latest",
    "pg": "^8.23.0",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
